# Public Expo values. Publishable keys are safe to ship in the app because
# Supabase Row Level Security protects the underlying data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Required for Expo push-token registration in a development or production build.
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
