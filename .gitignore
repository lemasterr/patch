# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Expo
/.expo/
/mobile/.expo/
/mobile/dist/
/mobile/node_modules/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated native projects
/mobile/ios/
/mobile/android/

# Expo exports and repository-local build evidence
/mobile/dist-*/
/mobile/web-build/
/mobile/coverage/
/tmp/
/artifacts/

# Signing and release credentials must remain outside version control.
*.cer
*.mobileprovision
*.p12
*.p8
*.keystore
*.jks
